{
  "name": "portfolio-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run gen:env && ng serve --configuration=development",
    "start:prod": "npm run gen:env && ng serve --configuration=production",
    "build": "npm run gen:env && ng build --configuration=development",
    "build:prod": "npm run gen:env && ng build --configuration=production",
    "gen:env": "node scripts/genenv.js",
    "vercel-build": "npm run build:prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\""
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "^22.6.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.0.8"
  }
}
